{
  "name": "vue-toast-alerts",
  "version": "1.0.0",
  "description": "A rounded, animated toast notification library for Vue 3 \u2014 including a centred, spring-animated toast.",
  "author": "Babatunde Lamidi",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "vue",
    "vue3",
    "toast",
    "alerts",
    "notifications",
    "snackbar",
    "composable",
    "ssr",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babatundelmd/vue-toast-alerts.git"
  },
  "homepage": "https://github.com/babatundelmd/vue-toast-alerts#readme",
  "bugs": {
    "url": "https://github.com/babatundelmd/vue-toast-alerts/issues"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/vue-toast-alerts.cjs",
  "module": "./dist/vue-toast-alerts.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-toast-alerts.js",
      "require": "./dist/vue-toast-alerts.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config docs/vite.config.ts",
    "build": "vite build && node scripts/copy-css.mjs",
    "build:docs": "vite build --config docs/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "prepublishOnly": "npm run lint:tokens && npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.1.4"
  }
}
